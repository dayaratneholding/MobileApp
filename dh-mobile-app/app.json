{
  "expo": {
    "name": "DH Mobile App",
    "slug": "dh-mobile-app",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/psk-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prasoking.dhmobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.pskerp.com",
      "googleServicesFile": "./google-services.json",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/psk-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/psk-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow DH Mobile App to use the camera for face attendance and group chat photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DH Mobile App to use the camera for face attendance and group chat photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DH Mobile App to save your location with attendance."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "defaultChannel": "chat"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "1e73c65b-5f74-4b12-a303-2012f9018f35"
      }
    }
  }
}
